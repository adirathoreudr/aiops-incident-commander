# .env.example
# Copy to .env and fill in real values before running locally.
# NEVER commit .env to git — it is gitignored.

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# ── EKS ───────────────────────────────────────────────────────────────────────
CLUSTER_NAME=aiops-incident-commander
NAMESPACE=aiops

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Support for OpenAI or Anthropic (Claude). 
# The agent will use Anthropic if ANTHROPIC_API_KEY is set and LLM_MODEL contains 'claude'.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Model config
# Examples: gpt-4o-mini, claude-3-5-sonnet-20240620
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Observability stack ───────────────────────────────────────────────────────
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090

# ── Service URLs (local dev) ──────────────────────────────────────────────────
COLLECTOR_URL=http://localhost:8000
AGENT_URL=http://localhost:8001
EXECUTOR_URL=http://localhost:8002

# ── API authentication ────────────────────────────────────────────────────────
# The executor's mutating endpoints (/approve, /execute/manual) patch live
# deployments. They fail CLOSED: with EXECUTOR_API_TOKEN unset they refuse every
# request, so an unconfigured deployment cannot be driven by anyone who can
# reach it. Generate per environment with:  openssl rand -hex 32
EXECUTOR_API_TOKEN=

# Protects /webhook/simulate, which puts an incident straight on the agent queue
# and can therefore trigger auto-remediation. When set, /webhook/alertmanager
# requires it too — configure Alertmanager's bearer_token to match before
# setting this, or real alert ingestion stops.
COLLECTOR_API_TOKEN=

# Comma-separated browser origins allowed to call the services. Was "*" on all
# three, which let any page in any browser reach a write path.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ── ArgoCD ────────────────────────────────────────────────────────────────────
ARGOCD_SERVER=https://argocd.your-domain.com
ARGOCD_TOKEN=
# TLS verification is on. If ArgoCD uses a self-signed certificate, point this
# at its CA bundle rather than disabling verification — the token above can roll
# back any application ArgoCD manages.
ARGOCD_CA_BUNDLE=

# ── Policy ───────────────────────────────────────────────────────────────────
AUTO_EXECUTE_THRESHOLD=0.75
ESCALATE_THRESHOLD=0.40
BLOCKED_NAMESPACES=kube-system,kube-public,cert-manager
HIGH_RISK_NAMESPACES=production,prod
MIN_CONFIDENCE_AUTO=0.75
MIN_CONFIDENCE_HIGH_RISK=0.90
MAX_SCALE_REPLICAS=20
MIN_SCALE_REPLICAS=1

# ── Collector ─────────────────────────────────────────────────────────────────
DEDUP_WINDOW_SECONDS=120
QUEUE_POLL_INTERVAL=2.0

# ── Executor ─────────────────────────────────────────────────────────────────
RECOVERY_TIMEOUT_SECONDS=120
RECOVERY_POLL_INTERVAL=5.0
IN_CLUSTER=false

# ── Knowledge base ────────────────────────────────────────────────────────────
RUNBOOKS_PATH=./knowledge-base/runbooks
INCIDENTS_PATH=./knowledge-base/incidents
USE_EMBEDDINGS=true
EMBED_MODEL=text-embedding-3-small

# ── UI ────────────────────────────────────────────────────────────────────────
# The UI proxies to these through Next rewrites (server-side only, so the
# browser never sees them and no service URL is baked into the bundle).
COLLECTOR_URL=http://localhost:8000
EXECUTOR_URL=http://localhost:8002
